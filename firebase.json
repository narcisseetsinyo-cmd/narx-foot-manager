{
  "hosting": {
    "public": "web/public",
    "ignore": ["**/.*"],
    "cleanUrls": true,
    "trailingSlash": true,
    "headers": [
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.@(png|webmanifest)", "headers": [{ "key": "Cache-Control", "value": "max-age=86400" }] }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
