rules_version = '2';
// NARX Foot Manager – règles de sécurité Cloud Firestore
// - Administration : compte e-mail/mot de passe admin@narx-foot-manager.app (créé dans Firebase Authentication)
// - Organisateurs (accès secondaire) : compte e-mail + code d'accès, validé par l'administration (organizers/<uid>.status == "valide"),
//   pour 1 an (365 jours) : expiresMs = date de fin d'accès en millisecondes.
//   Un organisateur ne modifie que SES compétitions, SES clubs et SES partenaires (champ « o » = son identifiant).
// - Dirigeants : accès anonyme automatique ; chacun ne modifie que SON club (clubreg/<son identifiant>)
// - Pièces justificatives (PDF) : lisibles uniquement par l'administration, le club concerné et son organisateur
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'admin@narx-foot-manager.app'
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function isOwner(cid) { return signedIn() && request.auth.uid == cid; }
    function isOrg() {
      return signedIn()
        && exists(/databases/$(database)/documents/organizers/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizers/$(request.auth.uid)).data.status == 'valide'
        && request.time.toMillis() < get(/databases/$(database)/documents/organizers/$(request.auth.uid)).data.get('expiresMs', 0);
    }
    // création : le document porte l'identifiant de l'organisateur ; modification : il lui appartient et le reste
    function orgCreate() { return isOrg() && request.resource.data.o == request.auth.uid; }
    function orgUpdate() { return isOrg() && resource.data.get('o', null) == request.auth.uid && request.resource.data.o == request.auth.uid; }
    function orgDelete() { return isOrg() && resource.data.get('o', null) == request.auth.uid; }
    function orgOwns(path) { return isOrg() && exists(path) && get(path).data.get('o', null) == request.auth.uid; }
    function orgOwnsOrNew(path) { return isOrg() && (!exists(path) || get(path).data.get('o', null) == request.auth.uid); }

    // Compétitions et matchs : lecture pour tous les utilisateurs connectés
    match /competitions/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || orgCreate();
      allow update: if isAdmin() || orgUpdate();
      allow delete: if isAdmin() || orgDelete();
      match /matches/{m} {
        allow read: if signedIn();
        allow write: if isAdmin() || orgOwns(/databases/$(database)/documents/competitions/$(id));
      }
    }
    match /partners/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || orgCreate();
      allow update: if isAdmin() || orgUpdate();
      allow delete: if isAdmin() || orgDelete();
    }
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Base des clubs : chaque dirigeant gère son propre club ; un organisateur gère les clubs qu'il a créés
    match /clubreg/{cid} {
      allow read: if signedIn();
      allow create: if isAdmin() || isOwner(cid) || orgCreate();
      allow update: if isAdmin() || isOwner(cid) || orgUpdate();
      allow delete: if isAdmin() || isOwner(cid) || orgDelete();
      match /photos/{pid} {
        allow read: if signedIn();
        allow write: if isAdmin() || isOwner(cid) || orgOwnsOrNew(/databases/$(database)/documents/clubreg/$(cid));
      }
    }

    // PDF des pièces : administration, club concerné et organisateur du club uniquement
    match /pieces/{cid}/{rest=**} {
      allow read, write: if isAdmin() || isOwner(cid) || orgOwnsOrNew(/databases/$(database)/documents/clubreg/$(cid));
    }

    // Demandes d'accès organisateur
    match /organizers/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow list: if isAdmin();
      allow create: if isOwner(uid)
        && ('email' in request.auth.token)
        && request.resource.data.status == 'en_attente';
      // l'organisateur peut seulement demander le renouvellement de son accès
      allow update: if isAdmin()
        || (isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['renouvellement']));
      allow delete: if isAdmin();
    }
  }
}
