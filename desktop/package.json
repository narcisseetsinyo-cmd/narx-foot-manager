{
  "name": "narx-foot-manager",
  "productName": "NARX Foot Manager",
  "version": "3.12.0",
  "description": "NARX Foot Manager – gestion de tournois et championnats de football",
  "author": "NARX",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac dmg zip --x64 --arm64"
  },
  "build": {
    "appId": "tg.agoenyive2.goldengenerationcup",
    "productName": "NARX Foot Manager",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "legalTrademarks": "NARX"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NARX Foot Manager",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "NARX-Foot-Manager-Setup-${version}.exe",
      "language": "1036",
      "uninstallDisplayName": "NARX Foot Manager"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.sports",
      "identity": null,
      "artifactName": "NARX-Foot-Manager-${version}-mac-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}